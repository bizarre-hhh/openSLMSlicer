// Windows resource template for openSLMSlicer.
// CMake configures this file into app_icon.rc and compiles it into the exe,
// so Explorer, the taskbar and the file properties dialog show the app logo.
#include <windows.h>

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "@OPENSLM_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0, 1, 0, 0
 PRODUCTVERSION 0, 1, 0, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "openSLMSlicer"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "openSLMSlicer"
            VALUE "OriginalFilename", "openSLMSlicer.exe"
            VALUE "ProductName", "openSLMSlicer"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
